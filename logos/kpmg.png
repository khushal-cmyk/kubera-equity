<script type="text/javascript">
    //Updated by AnandKumarSP
    /**
     * Step1: Get logged in user accounts information
     * Step2: If personalization is on, load personalization script
     * Step3: Trigger globalLoadCompleted to initialize the components
     */
    require(['/etc/clientlibs/kpmgpublic/pages/global.min-61c96c.js'], function() {
