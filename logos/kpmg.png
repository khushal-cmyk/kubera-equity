			"
			:class="[(classes && classes.label) ? classes.label : '']"
		>
			<span>
				{{ vm.label }}
			</span>
			<span
				class="icon icon-chevron-thin-right"
				:class="[(classes && classes.chevron) ? classes.chevron : '']"
			></span>
